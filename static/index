
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Work Archive - XIAO_STUDIO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;700&display=swap');

        :root {
            --bg-color: #f7f7f7;
            --text-main: #1a1a1a;
            --accent-color: #000;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'JetBrains Mono', monospace;
            margin: 0;
            padding: 2rem;
        }

        .main-container {
            max-width: 1320px; 
            margin: 0 auto;
        }

        .project-card {
            position: relative;
            aspect-ratio: 16 / 10;
            background: #000; /* 底色改為黑色，增加模糊後的對比 */
            border: 1px solid #eee;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
        }

        .project-card:hover {
            border-color: #000;
            transform: translateY(-2px);
        }

        .project-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(100%);
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            opacity: 0.9;
        }

        /* 懸停效果：整張圖片模糊並變亮 */
        .project-card:hover .project-image {
            filter: grayscale(0%) blur(8px) brightness(1.2);
            opacity: 0.4;
            transform: scale(1.05);
        }

        .project-info {
            position: absolute;
            inset: 0; /* 撐滿整個容器 */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            background: rgba(255, 255, 255, 0); /* 初始透明 */
            transform: translateY(0);
            opacity: 0;
            transition: all 0.4s ease;
            text-align: center;
        }

        /* 懸停時資訊顯示：背景變亮白，文字黑色 */
        .project-card:hover .project-info {
            background: rgba(255, 255, 255, 0.6); /* 亮色半透明背景 */
            opacity: 1;
        }

        /* 確保文字為深黑色 */
        .project-title {
            color: #000;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .project-category {
            color: #333;
            font-weight: 700;
        }

        .header-line {
            height: 1px;
            background: #ddd;
            margin: 1.5rem 0 3rem 0;
            position: relative;
        }

        .status-dot {
            color: #888;
        }

        .load-more-container {
            display: flex;
            justify-content: center;
            margin-top: 4rem;
        }

        .load-more-btn {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            padding: 1rem 3rem;
            border: 1px solid #000;
            background: transparent;
            color: #000;
            transition: all 0.3s ease;
            text-transform: uppercase;
        }

        .load-more-btn:hover {
            background: #000;
            color: #fff;
        }
    </style>
</head>
<body>

    <div class="main-container">
        <!-- 頁首標題 -->
        <header class="flex justify-between items-end mb-6">
            <div>
                <div class="text-[0.6rem] text-gray-400 mb-1 tracking-[0.2em]">FILE_STORAGE / ARCHIVE_2026</div>
                <h1 class="text-4xl font-bold tracking-tighter text-gray-800 uppercase">Static_Works</h1>
            </div>
            <div class="text-right">
                <div class="text-[0.6rem] text-gray-400 uppercase">System_Status</div>
                <div class="text-xs font-bold status-dot tracking-widest">● BROWSING_MODE</div>
            </div>
        </header>

        <div class="header-line"></div>

        <!-- 作品網格 -->
        <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <script>
                const placeholderImg = "https://res.cloudinary.com/dssycfvxr/image/upload/v1774519177/soon_sumlkv.jpg";
                const projects = [
                    { id: "01", title: "Branding_Identity_V1", category: "IDENTITY" },
                    { id: "02", title: "Motion_Graphics_Core", category: "VISUAL" },
                    { id: "03", title: "Package_Architecture", category: "PACKAGING" },
                    { id: "04", title: "System_Interface_04", category: "UI/UX" },
                    { id: "05", title: "Poster_Series_Final", category: "PRINT" },
                    { id: "06", title: "Interactive_Module", category: "INTERACTIVE" },
                    { id: "07", title: "Publication_Layout", category: "EDITORIAL" },
                    { id: "08", title: "Visual_Campaign_24", category: "CAMPAIGN" },
                    { id: "09", title: "Type_Specimen_X", category: "TYPOGRAPHY" },
                    { id: "10", title: "Web_Prototype_V3", category: "DEVELOPMENT" }
                ];

                projects.forEach(p => {
                    document.write(`
                        <div class="project-card">
                            <img src="${placeholderImg}" alt="${p.title}" class="project-image">
                            
                            <div class="project-info">
                                <div class="project-category text-[0.6rem] uppercase tracking-[0.3em] mb-2">${p.category}</div>
                                <div class="project-title text-xl uppercase">${p.title}</div>
                                <div class="w-8 h-[2px] bg-black my-4"></div>
                                <div class="text-[0.6rem] font-bold text-black border border-black px-4 py-2 hover:bg-black hover:text-white transition-all">
                                    VIEW_ARCHIVE
                                </div>
                            </div>
                        </div>
                    `);
                });
            </script>

        </div>

        <!-- 加載按鈕 -->
        <div class="load-more-container">
            <button class="load-more-btn" onclick="this.innerText='SYNCING_DATABASE...'; setTimeout(()=>this.innerText='END_OF_ARCHIVE', 1500)">
                Load_More_Entries
            </button>
        </div>

        <!-- 頁尾 -->
        <footer class="mt-20 pt-8 border-t border-gray-200 text-center md:text-left">
            <div class="text-[0.55rem] text-gray-400 uppercase tracking-[0.3em]">
                End_of_Transmission // Xiao_Studio_Archive_v3.0
            </div>
        </footer>
    </div>

</body>
</html>
